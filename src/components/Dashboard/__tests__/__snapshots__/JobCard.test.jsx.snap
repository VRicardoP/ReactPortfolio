exports[`JobCard > preserva la estructura de la variante match 1`] = `
<article
  class="ai-match-card"
  style="border: 1px solid rgb(51, 51, 51);"
>
  <div
    class="ai-match-card-header"
  >
    <div
      class="ai-match-card-title-col"
    >
      <div
        class="ai-match-card-title"
        style="color: rgb(255, 255, 255);"
      >
        English
        <span
          class="ai-match-translated-badge"
          title="Original"
        >
          dashboard.aiMatch.translated
        </span>
      </div>
      <div
        class="ai-match-card-company"
        style="color: rgb(221, 221, 221);"
      >
        <span>
          Example
        </span>
      </div>
    </div>
    <div
      class="ai-match-card-score-col"
    >
      <span
        class="ai-match-score"
        style="color: rgb(0, 229, 255);"
      >
        91
        %
      </span>
      <span
        class="ai-match-fit-badge fit-good"
      >
        GOOD
      </span>
    </div>
  </div>
  <div
    class="ai-match-card-meta"
  >
    <span
      class="ai-match-card-meta-text"
      style="color: rgb(221, 221, 221);"
    >
      Bern
    </span>
    <span>
      badges
    </span>
  </div>
  <p>
    summary
  </p>
  <button
    aria-expanded="true"
    class="ai-match-skills-toggle"
    style="color: rgb(0, 229, 255);"
  >
    dashboard.aiMatch.skillsAnalysis
     
    -
  </button>
  <div
    class="ai-match-skills-detail"
  >
    <div
      class="ai-match-skills-group"
    >
      <span
        class="ai-match-skills-label text-success"
      >
        [OK] 
        dashboard.aiMatch.matchingSkills
        :
      </span>
      <div
        class="ai-match-skills-tags"
      >
        <span
          class="ai-match-skill-tag-match"
        >
          React
        </span>
      </div>
    </div>
    <div
      class="ai-match-skills-group"
    >
      <span
        class="ai-match-skills-label text-danger"
      >
        [X] 
        dashboard.aiMatch.missingSkills
        :
      </span>
      <div
        class="ai-match-skills-tags"
      >
        <span
          class="ai-match-skill-tag-miss"
        >
          Go
        </span>
      </div>
    </div>
    <p
      class="ai-match-reason"
    >
      Good fit
    </p>
  </div>
  <div
    class="ai-match-card-footer"
  >
    <time>
      2026-10-23
    </time>
    <div
      class="ai-match-card-actions"
    >
      <button>
        Save
      </button>
    </div>
  </div>
</article>
`;

